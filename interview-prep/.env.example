# Copy to .env for local use. Never put real credentials in this example.
MONGODB_URI=mongodb://localhost:27017/interview-prep-dev
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3001
# Backend PORT only. Render supplies its own PORT.
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_EMBEDDING_MODEL=
SERPAPI_KEY=
# 0 locally; 1 for the Render ingress. Verify your actual proxy topology.
TRUST_PROXY_HOPS=0
