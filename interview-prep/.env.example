# Copy to .env for local use. Never put real credentials in this example.
MONGODB_URI=mongodb://localhost:27017/interview-prep-dev
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3001
# Backend PORT only. Render supplies its own PORT.
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_2_PROVIDER=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_3_PROVIDER=
AI_FALLBACK_3_API_KEY=
AI_FALLBACK_3_MODEL=
AI_FALLBACK_3_BASE_URL=


# AI_EMBEDDING_MODEL is optional. It specifies the AI model used to convert text into numeric vectors for semantic search or similarity matching. Leave it blank unless the application’s semantic-search features require embeddings.
# SERPAPI_KEY is also optional. It enables SerpAPI-powered web search. Without it, the app uses its configured fallback search provider instead.
AI_EMBEDDING_MODEL=
SERPAPI_KEY=
# 0 locally; 1 for the Render ingress. Verify your actual proxy topology.
TRUST_PROXY_HOPS=0
