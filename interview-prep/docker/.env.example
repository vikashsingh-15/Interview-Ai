# Docker Environment Variables

# Application
MONGODB_URI=mongodb://mongodb:27017/interview-prep
MONGODB_USER=interviewprep
MONGODB_PASSWORD=changeme-in-production

# Backend
JWT_SECRET=your-super-secret-jwt-key-change-in-production
FRONTEND_PORT=3000
BACKEND_PORT=3001

# External URLs (for production)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Cluster access (for MongoDB Atlas in production)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/interview-prep
