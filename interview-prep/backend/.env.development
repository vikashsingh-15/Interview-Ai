# Server
NODE_ENV=development
PORT=3001
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/interview-prep-dev

# Authentication - Development only, use strong secrets in production
JWT_SECRET=dev-secret-change-in-production-1234567890abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# Session/Cookie
SESSION_COOKIE_NAME=interview_prep_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Email - Using Ethereal for development
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@interviewprep.dev

# AI Providers - Use development mode without real keys
OPENAI_API_KEY=sk-dev-key-not-for-production
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=60000
OPENAI_RETRY_COUNT=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

NVIDIA_API_KEY=
NVIDIA_MODEL=playground-llama3

# Custom AI Provider
CUSTOM_AI_PROVIDER_URL=
CUSTOM_AI_API_KEY=

# AI Configuration
AI_DEFAULT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-ada-002

# Redis
REDIS_URL=redis://localhost:6379

# Vector Search
VECTOR_SEARCH_ENABLED=false

# File Upload
UPLOAD_MAX_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Feature Flags
EMAIL_VERIFICATION_ENABLED=false
NOTIFICATIONS_ENABLED=true
MARKET_CALIBRATION_ENABLED=true

# Rate Limiting - More lenient in development
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Swagger
SWAGGER_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin
