[TEMPLATE]
# Server
NODE_ENV=development
PORT=3001
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/interview-prep

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
SESSION_COOKIE_NAME=interview_prep_session
SESSION_COOKIE_SAME_SITE=lax

# Email
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@interviewprep.dev

# AI Providers (optional — powers AI answer evaluation, answer synthesis and
# AI question generation; without a key the app uses heuristic grading and
# template questions so everything still works offline)
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=60000
OPENAI_RETRY_COUNT=3

# Web Search / Scraper
# auto | serpapi | duckduckgo | none  ('auto' uses SerpApi when a key is set, else free providers)
SEARCH_PROVIDER=auto
SERPAPI_KEY=
SEARCH_STACKEXCHANGE_ENABLED=true
STACKEXCHANGE_KEY=
STACKEXCHANGE_SITE=stackoverflow
SEARCH_MAX_RESULTS=10
SEARCH_MAX_SCRAPED_PAGES=4
SEARCH_SCRAPE_TIMEOUT_MS=10000
SEARCH_MAX_PAGE_BYTES=800000
SEARCH_MAX_CONTENT_CHARS=4000
SEARCH_CACHE_TTL_HOURS=24
SEARCH_RESPECT_ROBOTS=true
SEARCH_AI_SYNTHESIS=true

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Feature flags
EMAIL_VERIFICATION_ENABLED=false
MARKET_CALIBRATION_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
