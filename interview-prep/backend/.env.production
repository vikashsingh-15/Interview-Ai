# Server
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database - Use MongoDB Atlas in production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview-prep?retryWrites=true&w=majority

# Authentication - Use strong, unique secrets
JWT_SECRET=<generate-strong-secret-using-openssl-rand-hex-64>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Session/Cookie - Secure in production
SESSION_COOKIE_NAME=interview_prep_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict

# Email - Use production email service
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@yourdomain.com
SENDGRID_API_KEY=<your-sendgrid-api-key>

# AI Providers - Use production API keys
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=60000
OPENAI_RETRY_COUNT=3

GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-pro

NVIDIA_API_KEY=<your-nvidia-api-key>
NVIDIA_MODEL=playground-llama3

# Custom AI Provider (optional)
CUSTOM_AI_PROVIDER_URL=<your-custom-provider-url>
CUSTOM_AI_API_KEY=<your-custom-provider-api-key>

# AI Configuration
AI_DEFAULT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-ada-002

# Redis - Use managed Redis in production
REDIS_URL=redis://:<password>@<redis-host>:6379

# Vector Search - MongoDB Atlas Vector Search
VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_INDEX=question_embeddings

# File Upload
UPLOAD_MAX_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx

# URLs
FRONTEND_URL=https://app.interviewprep.com
BACKEND_URL=https://api.interviewprep.com

# Feature Flags
EMAIL_VERIFICATION_ENABLED=true
NOTIFICATIONS_ENABLED=true
MARKET_CALIBRATION_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Swagger - Disable in production or secure with strong credentials
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Monitoring
SENTRY_DSN=
APPLICATION_INSIGHTS_CONNECTION_STRING=
