{
  "name": "interview-prep",
  "version": "1.0.0",
  "description": "Personalized SDE Interview Preparation Platform",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs backend",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:db": "node scripts/dev.mjs db",
    "stop": "node scripts/stop.mjs",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cd backend && npm run test:unit",
    "test:integration": "cd backend && npm run test:integration",
    "test:e2e": "cd frontend && npm run test:e2e",
    "lint": "cd backend && npm run lint && cd frontend && npm run lint",
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "seed:all": "cd backend && npm run seed:all"
  },
  "keywords": [
    "interview",
    "sde",
    "preparation",
    "coaching",
    "system-design",
    "coding"
  ],
  "author": "",
  "license": "MIT"
}
