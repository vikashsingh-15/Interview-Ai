<resources>
  <style name="Theme.JobPrep" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/jobprep_blue</item>
    <item name="android:statusBarColor">@color/jobprep_navy</item>
    <item name="android:navigationBarColor">@color/jobprep_navy</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
